
clear all;close all;clc
s=tf('s');

optionss=bodeoptions;
optionss.MagVisible='on';
optionss.PhaseMatching='on';
optionss.PhaseMatchingValue=-180;
optionss.PhaseMatchingFreq=1;
optionss.Grid='on';

Ts = 20e-3;
p1  =   -17;
p2  =   -18;
kb   =   0.042;
P_barra = kb * p1 * p2/( (s-p1) * (s-p2) );

kc = db2mag(32);
cero_c = -19;
polo_c = -30;
C   =   zpk([cero_c, cero_c],[0, polo_c],kc);

L = minreal(C*P_barra);


C_dig = c2d(C,Ts,'tustin');
[b, a] = tfdata(C_dig, 'v');

fprintf('float u_0 = %.4f*u_1 + %.4f*u_2 + %.4f*e_0 + %.4f*e_1 + %.4f*e_2;\n', ...
    -a(2), -a(3), b(1), b(2), b(3));
float u_0 = 1.5385 * u_1 - 0.5385 * u_2 + 3.865 * e_0 - 5.2618 * e_1 + 1.7909 * e_2; // mf 55 (msa rapido ok)

% figuras
figure();
bode(L,optionss);title("L");
